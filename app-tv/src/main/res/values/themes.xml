<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base TV theme. Theme.Leanback extends Theme.AppCompat.NoActionBar and provides
      the focus / D-pad infrastructure expected by Leanback Fragments.

      windowBackground is intentionally a flat near-black for fast paint on LOW tier;
      richer gradients/blurs are applied per-screen and tier-gated in later phases.
    -->
    <style name="Theme.KStreamTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@style/KStreamTv.WindowAnimation</item>
    </style>

    <!-- ===== Typography ===== -->
    <!-- Display: hero title, splash. -->
    <style name="TextAppearance.KStream.Display" parent="@android:style/TextAppearance">
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">12</item>
    </style>

    <!-- Section: rail headers ("Continue Watching"). -->
    <style name="TextAppearance.KStream.Section" parent="@android:style/TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Card: poster overlay title. -->
    <style name="TextAppearance.KStream.Card" parent="@android:style/TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Meta: year, rating, duration. -->
    <style name="TextAppearance.KStream.Meta" parent="@android:style/TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Body: synopsis, descriptions. -->
    <style name="TextAppearance.KStream.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!--
      Minimal cross-Activity transitions. Tier-gated upgrades happen at runtime;
      LOW tier keeps these to avoid extra GPU work on first paint.
    -->
    <style name="KStreamTv.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

</resources>
