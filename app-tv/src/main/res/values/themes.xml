<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base TV theme. Theme.Leanback extends Theme.AppCompat.NoActionBar and provides
      the focus / D-pad infrastructure expected by Leanback Fragments.

      windowBackground is intentionally a flat near-black for fast paint on LOW tier;
      richer gradients/blurs are applied per-screen and tier-gated in later phases.
    -->
    <!-- Base TV theme. Provides cinematic dark background + brighter row headers. -->
    <style name="Theme.KStreamTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@style/KStreamTv.WindowAnimation</item>
        <item name="rowHeaderStyle">@style/KStream.RowHeader</item>
        <item name="rowHeaderDescriptionStyle">@style/KStream.RowHeader</item>
    </style>

    <!-- Splash uses pure black so the brand animation reads as edge-to-edge cinema. -->
    <style name="Theme.KStreamTv.Splash" parent="Theme.KStreamTv">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Bright, premium rail header (overrides Leanback's dim default). -->
    <style name="KStream.RowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:alpha">1.0</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <!-- ===== Typography ===== -->
    <!-- Display: hero title, splash. -->
    <style name="TextAppearance.KStream.Display" parent="@android:style/TextAppearance">
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">12</item>
    </style>

    <!-- Section: rail headers ("Continue Watching"). -->
    <style name="TextAppearance.KStream.Section" parent="@android:style/TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Card: poster overlay title. -->
    <style name="TextAppearance.KStream.Card" parent="@android:style/TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Meta: year, rating, duration. -->
    <style name="TextAppearance.KStream.Meta" parent="@android:style/TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Body: synopsis, descriptions. -->
    <style name="TextAppearance.KStream.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="PersonalToolbarAction" parent="@android:style/TextAppearance">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@drawable/bg_personal_select_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Minimal cross-Activity transitions. Tier-gated upgrades happen at runtime;
      LOW tier keeps these to avoid extra GPU work on first paint.
    -->
    <style name="KStreamTv.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Reusable TV action buttons (Play / Resume / Download / Like / Retry). -->
    <style name="TvActionButton" parent="android:Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="TvActionButton.Primary">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TvActionButton.Secondary">
            <item name="android:background">@drawable/btn_secondary_bg</item>
        </style>

        <!-- Terms & Conditions section styles -->
        <style name="TermsSectionTitle" parent="@android:style/TextAppearance">
            <item name="android:layout_width">wrap_content</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_marginTop">@dimen/space_lg</item>
            <item name="android:textColor">@color/text_primary</item>
            <item name="android:textSize">20sp</item>
            <item name="android:textStyle">bold</item>
        </style>

        <style name="TermsSectionBody" parent="@android:style/TextAppearance">
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_marginTop">@dimen/space_sm</item>
            <item name="android:textColor">@color/text_secondary</item>
            <item name="android:textSize">15sp</item>
            <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

</resources>
