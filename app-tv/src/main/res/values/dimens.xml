<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Spacing (8dp grid) ===== -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_xxl">48dp</dimen>
    <dimen name="space_xxxl">64dp</dimen>

    <!-- ===== TV overscan-safe padding ===== -->
    <dimen name="tv_overscan_horizontal">48dp</dimen>
    <dimen name="tv_overscan_vertical">27dp</dimen>

    <!-- ===== Card dimensions =====
         Spotlight pattern: each card morphs between portrait (resting) and
         landscape (when focused). Sibling tiles stay at the portrait width;
         the focused one expands to spotlight_width × spotlight_height.
    -->
    <dimen name="card_poster_width">120dp</dimen>
    <dimen name="card_poster_height">180dp</dimen>
    <dimen name="card_root_width">120dp</dimen>
    <!-- Padding around each card root that hosts the focus ring foreground.
         The ring is painted at this padded edge, so it sits this many dp
         outside the visible poster artwork. -->
    <dimen name="card_focus_padding">8dp</dimen>
    <dimen name="card_root_focused_width">400dp</dimen>
    <dimen name="spotlight_width">400dp</dimen>
    <dimen name="spotlight_height">225dp</dimen>
    <dimen name="card_focused_poster_width">280dp</dimen>
    <dimen name="card_poster_corner">16dp</dimen>
    <dimen name="card_poster_spacing">32dp</dimen>

    <!-- ===== Section header ===== -->
    <dimen name="rail_header_padding_top">36dp</dimen>
    <dimen name="rail_header_padding_bottom">16dp</dimen>

    <!-- ===== Focus ring ===== -->
    <dimen name="focus_ring_stroke">3dp</dimen>
    <dimen name="focus_ring_corner">8dp</dimen>

    <!-- ===== Details screen ===== -->
    <dimen name="details_poster_width">220dp</dimen>
    <dimen name="details_poster_height">330dp</dimen>
    <dimen name="details_backdrop_height">420dp</dimen>

    <!-- ===== Cast row ===== -->
    <dimen name="cast_avatar_size">96dp</dimen>
    <dimen name="cast_avatar_spacing">16dp</dimen>
</resources>
