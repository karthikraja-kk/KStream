<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides for Leanback's built-in dimensions so the Home rails sit
  tight against the sticky preview pane without Leanback's default
  ~32dp top padding and ~24dp header padding eating most of the rails
  area on 540dp-tall TVs.

  All names mirror dimens declared in androidx.leanback so the library's
  lb_list_row.xml / lb_rows_fragment.xml pick up our values at resource
  merge time.
-->
<resources>
    <!-- Top padding of the RowsSupportFragment's vertical grid view. -->
    <dimen name="lb_browse_padding_top">0dp</dimen>
    <dimen name="lb_browse_padding_bottom">0dp</dimen>

    <!-- Gap above each rail header. -->
    <dimen name="lb_browse_header_padding_top">0dp</dimen>
    <!-- Gap between rail header text and the horizontal poster grid. -->
    <dimen name="lb_browse_header_padding_bottom">2dp</dimen>

    <!-- Top margin of the rows fragment (between top fade and first row). -->
    <dimen name="lb_browse_rows_margin_top">0dp</dimen>
    <dimen name="lb_browse_rows_margin_start">0dp</dimen>

    <!-- Rail header height. Default is huge (~40dp) — we shrink it so
         the header text is exactly tall enough for one line plus a hair. -->
    <dimen name="lb_browse_header_height">28dp</dimen>

    <!-- Section header text size — match our compact tile aesthetic. -->
    <dimen name="lb_browse_header_text_size">16sp</dimen>

    <!-- Spacing between top of header dock and row content. -->
    <dimen name="lb_browse_row_padding_top">0dp</dimen>
    <dimen name="lb_browse_row_padding_bottom">0dp</dimen>
</resources>
