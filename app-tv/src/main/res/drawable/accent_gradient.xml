<?xml version="1.0" encoding="utf-8"?>
<!-- Brand gradient stroke / fill — orange (top) → magenta (mid) → purple (bottom). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/accent_warm"
        android:centerColor="@color/accent_primary"
        android:endColor="@color/accent_cool"
        android:type="linear" />
    <corners android:radius="10dp" />
</shape>
