<?xml version="1.0" encoding="utf-8"?>
<!--
  Gradient scrim drawn on top of the hero backdrop so the text content is
  readable regardless of poster art. Vertical gradient from solid bg at the
  bottom to fully transparent ~60% up the hero.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/bg_base"
        android:centerColor="#CC08090C"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
