<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring drawn on the poster_frame edges (frame is 6dp larger than the
     poster image, so the ring frames it cleanly without overlapping artwork). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="@color/accent_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>

