<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action button. Warm→Magenta brand gradient with white stroke
     when focused. Used for Play. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF6B1A"
                android:endColor="#FFE91E63" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF8843"
                android:endColor="#FFE03968" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF6B1A"
                android:endColor="#FFE91E63" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
