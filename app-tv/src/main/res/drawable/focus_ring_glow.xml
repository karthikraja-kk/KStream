<?xml version="1.0" encoding="utf-8"?>
<!--
  MID/HIGH tier focus indicator: gold border with soft inner gradient halo.
  Uses layer-list (cheap, no runtime shadow allocation) so even MID tier
  Fire TV devices handle it without redraw stutter.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#33E8C36A"
                        android:centerColor="#11E8C36A"
                        android:endColor="#33E8C36A"
                        android:type="linear" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/accent_gold" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_dim" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
