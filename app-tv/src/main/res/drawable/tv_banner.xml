<?xml version="1.0" encoding="utf-8"?>
<!--
  TV launcher banner. Required size: 320dp x 180dp.
  P0 uses a brand-color shape with the wordmark overlay — replaced by a final
  PNG/vector banner asset in a polish pass.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/banner_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
        </shape>
    </item>
</layer-list>
