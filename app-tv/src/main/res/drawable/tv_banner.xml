<?xml version="1.0" encoding="utf-8"?>
<!--
  TV launcher banner. Required size: 320dp x 180dp.
  Brand-tinted background + centered horizontal wordmark logo so the tile
  is recognizable in the Fire TV / Leanback launcher.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/banner_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
        </shape>
    </item>
    <item
        android:left="24dp"
        android:right="24dp"
        android:top="24dp"
        android:bottom="24dp">
        <bitmap
            android:gravity="center|fill"
            android:src="@drawable/kstream_logo_horizontal" />
    </item>
</layer-list>

