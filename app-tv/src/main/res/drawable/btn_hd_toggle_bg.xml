<?xml version="1.0" encoding="utf-8"?>
<!--
  HD-only toggle pill.
  - Selected (filter ON)         : solid brand magenta fill.
  - Focused, not selected        : gradient halo + stroke.
  - Focused, selected            : deeper halo with white border.
  - Default (filter OFF)         : outlined transparent pill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <layer-list>
            <item android:left="-6dp" android:top="-6dp" android:right="-6dp" android:bottom="-6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#66FF6B1A"
                        android:centerColor="#80E91E63"
                        android:endColor="#666A1A9A"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_primary" />
                    <stroke android:width="2dp" android:color="@android:color/white" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:left="-6dp" android:top="-6dp" android:right="-6dp" android:bottom="-6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#66FF6B1A"
                        android:centerColor="#80E91E63"
                        android:endColor="#666A1A9A"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <stroke android:width="2dp" android:color="@color/accent_primary" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
