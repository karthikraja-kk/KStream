<?xml version="1.0" encoding="utf-8"?>
<!--
    Sleek brand-themed pill background used for the HD ON/OFF indicator and the
    name-edit hint chip. Two states: focused (magenta filled) and idle (outlined).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/accent_gold" />
            <stroke android:width="1dp" android:color="@color/accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#22FFFFFF" />
            <stroke android:width="1dp" android:color="@color/text_tertiary" />
        </shape>
    </item>
</selector>
