<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular top-bar icon background.
  - Focused : gradient glow halo (insets pull outward) + magenta stroke.
  - Default : faint surface tint for affordance.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:left="-6dp"
                android:top="-6dp"
                android:right="-6dp"
                android:bottom="-6dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#66FF6B1A"
                        android:centerColor="#80E91E63"
                        android:endColor="#666A1A9A"
                        android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33000000" />
                    <stroke android:width="2dp" android:color="@color/accent_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
