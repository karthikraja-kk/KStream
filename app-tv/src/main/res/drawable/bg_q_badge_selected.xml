<?xml version="1.0" encoding="utf-8"?>
<!-- Currently-selected quality (highest available preferred). Brand gradient
     fill so it pops in the row even without focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF6B1A"
                android:endColor="#FFE91E63" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#4DFF6B1A"
                android:endColor="#4DE91E63" />
            <stroke android:width="1dp" android:color="#8CE91E63" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
