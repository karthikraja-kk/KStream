<?xml version="1.0" encoding="utf-8"?>
<!--
  Vertical gradient: transparent at the top, opaque black at the bottom.
  Sits flush along the lower edge of the preview backdrop so the seam
  between preview pane and the rails area below it is invisible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:endColor="#FF000000"
        android:type="linear" />
</shape>
