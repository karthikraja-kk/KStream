<?xml version="1.0" encoding="utf-8"?>
<!-- Right half (▼ caret) of the Resume split-button. Same gradient as the
     left half plus a subtle inner-shadow separator at the leading edge so
     the split is visible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF6B1A"
                android:endColor="#FFE91E63" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="#FFFF6B1A"
                        android:endColor="#FFE91E63" />
                    <corners
                        android:topLeftRadius="0dp"
                        android:bottomLeftRadius="0dp"
                        android:topRightRadius="10dp"
                        android:bottomRightRadius="10dp" />
                </shape>
            </item>
            <!-- 1px darker separator at the left edge -->
            <item android:width="1dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="#2E000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
