<?xml version="1.0" encoding="utf-8"?>
<!--
  LOW tier focus indicator: sharp 3dp gold border, no glow, no shadow.
  Zero overdraw cost, perfectly crisp on 540p/720p panels.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/accent_gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_dim" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
