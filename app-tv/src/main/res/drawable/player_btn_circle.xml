<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact circular play/pause button — thin stroke, sleek silhouette.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFFF6B1A"
                android:centerColor="#FFE91E63"
                android:endColor="#FF6A1A9A" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFFF6B1A"
                android:centerColor="#FFE91E63"
                android:endColor="#FF6A1A9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFFF6B1A"
                android:centerColor="#FFE91E63"
                android:endColor="#FF6A1A9A" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
