<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium welcome layout for Android TV:
   - Left column (60%): big greeting + supporting copy
   - Right column (40%): input field, error text, primary & secondary buttons
  Designed to fit comfortably inside overscan-safe bounds on 1080p panels.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:paddingHorizontal="@dimen/tv_overscan_horizontal"
    android:paddingVertical="@dimen/tv_overscan_vertical"
    tools:ignore="UnusedAttribute">

    <!-- ===== Left column: brand + headline ===== -->
    <LinearLayout
        android:id="@+id/welcome_left_col"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/welcome_right_col"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/kstream_logo_with_name" />

        <View
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/accent_gold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:maxLines="2"
            android:text="@string/welcome_headline"
            android:textAppearance="@style/TextAppearance.KStream.Display"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:maxWidth="520dp"
            android:maxLines="3"
            android:text="@string/welcome_subtitle"
            android:textAppearance="@style/TextAppearance.KStream.Body"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <!-- ===== Right column: input + actions ===== -->
    <LinearLayout
        android:id="@+id/welcome_right_col"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/welcome_left_col"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_label_name"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.KStream.Meta" />

        <EditText
            android:id="@+id/welcome_name_field"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_sm"
            android:autofillHints="username"
            android:background="@drawable/focus_ring_low"
            android:hint="@string/welcome_name_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="yes"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="24"
            android:nextFocusDown="@+id/welcome_continue_btn"
            android:nextFocusForward="@+id/welcome_continue_btn"
            android:paddingHorizontal="@dimen/space_md"
            android:singleLine="true"
            android:text="@string/welcome_default_name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/welcome_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/state_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/welcome_continue_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/focus_ring_glow"
            android:enabled="false"
            android:nextFocusUp="@id/welcome_name_field"
            android:nextFocusDown="@+id/welcome_terms_row"
            android:text="@string/welcome_continue"
            android:textAllCaps="true"
            android:textColor="@color/accent_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/welcome_terms_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:nextFocusUp="@id/welcome_continue_btn"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/welcome_terms_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_gold"
                android:focusable="true"
                android:nextFocusRight="@+id/welcome_terms_text"
                android:nextFocusUp="@id/welcome_continue_btn" />

            <TextView
                android:id="@+id/welcome_terms_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/focus_ring_low"
                android:focusable="true"
                android:nextFocusLeft="@id/welcome_terms_check"
                android:nextFocusUp="@id/welcome_continue_btn"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- TMDb attribution removed from welcome (shown in Terms & Conditions instead). -->

</androidx.constraintlayout.widget.ConstraintLayout>
