<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium welcome screen (redesign).

  Adaptive 55/45 two-pane via percent guideline so the layout scales
  on 720p / 1080p / 4K without hard-coded widths.

   - Left brand pane  : logo-with-name image + 4dp brand-gradient stripe
                        + autosizing headline + autosizing subtitle.
                        Vertically centered (bias 0.5).
   - Right action card: glass card (bg_welcome_card) holding eyebrow,
                        card title, name input (underline lights magenta
                        on focus), gradient pill CTA, and the existing
                        terms-checkbox row. Card width = match_parent
                        capped at maxWidth 480dp; centered vertically.

  All entry animations + adaptive logo width are wired in
  WelcomeActivity.onCreate.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:paddingHorizontal="@dimen/tv_overscan_horizontal"
    android:paddingVertical="@dimen/tv_overscan_vertical"
    tools:ignore="UnusedAttribute">

    <!-- 55/45 split. Right pane starts at 55% so the brand pane
         (logo + headline) gets the more generous half. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/welcome_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

    <!-- ============ LEFT BRAND PANE ============ -->
    <LinearLayout
        android:id="@+id/welcome_left_col"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="@dimen/space_xxl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/welcome_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Logo with name. Width is adjusted at runtime to
             min(40% pane width, 360dp) so 4K panels get a larger mark. -->
        <ImageView
            android:id="@+id/welcome_logo"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/kstream_logo_with_name" />

        <View
            android:id="@+id/welcome_stripe"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/accent_gradient" />

        <TextView
            android:id="@+id/welcome_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:maxLines="2"
            android:text="@string/welcome_headline"
            android:textAppearance="@style/TextAppearance.KStream.Display"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp" />

        <TextView
            android:id="@+id/welcome_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:maxWidth="520dp"
            android:maxLines="2"
            android:text="@string/welcome_subtitle"
            android:textAppearance="@style/TextAppearance.KStream.Body"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <!-- ============ RIGHT ACTION CARD ============ -->
    <LinearLayout
        android:id="@+id/welcome_right_col"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_welcome_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingVertical="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/welcome_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintWidth_max="480dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/accent_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/welcome_card_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/welcome_name_field"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_lg"
            android:autofillHints="username"
            android:background="@drawable/bg_welcome_name_underline"
            android:hint="@string/welcome_name_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="yes"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="24"
            android:nextFocusDown="@+id/welcome_continue_btn"
            android:nextFocusForward="@+id/welcome_continue_btn"
            android:paddingHorizontal="2dp"
            android:singleLine="true"
            android:text="@string/welcome_default_name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/welcome_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/state_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/welcome_continue_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_welcome_cta_primary"
            android:foreground="@drawable/focus_ring_glow"
            android:enabled="false"
            android:nextFocusUp="@id/welcome_name_field"
            android:nextFocusDown="@+id/welcome_terms_row"
            android:stateListAnimator="@null"
            android:text="@string/welcome_continue"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/welcome_terms_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:nextFocusUp="@id/welcome_continue_btn"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/welcome_terms_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_primary"
                android:focusable="true"
                android:nextFocusRight="@+id/welcome_terms_text"
                android:nextFocusUp="@id/welcome_continue_btn" />

            <TextView
                android:id="@+id/welcome_terms_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/focus_ring_low"
                android:focusable="true"
                android:nextFocusLeft="@id/welcome_terms_check"
                android:nextFocusUp="@id/welcome_continue_btn"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
