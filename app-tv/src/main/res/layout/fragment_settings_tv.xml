<?xml version="1.0" encoding="utf-8"?>
<!--
    Sleek brand-themed settings. Hero (avatar + name + stats) + 3 grouped tile sections.
    Replaces SwitchCompat with a focusable ON/OFF pill; name uses a tap-to-edit tile.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="40dp"
        android:paddingBottom="48dp">

        <!-- ============= HERO ============= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_settings_avatar">
                <TextView
                    android:id="@+id/settings_avatar_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="F" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_hero_greeting"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.28"
                    android:textAllCaps="true" />

                <!-- Name = TextView by default + hidden EditText. Pencil toggles to edit;
                     tick saves. Avoids in-layout EditText focus pitfalls on Fire TV. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_name_input">
                    <TextView
                        android:id="@+id/settings_name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Bharath" />
                    <EditText
                        android:id="@+id/settings_name_edit"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="textCapWords"
                        android:imeOptions="actionDone"
                        android:textColor="@color/text_primary"
                        android:textColorHighlight="#55E91E63"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="gone" />
                    <ImageView
                        android:id="@+id/settings_name_action"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="10dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_settings_pencil"
                        android:background="@drawable/bg_name_action"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="@string/settings_name_edit_hint" />
                </LinearLayout>

                <!-- Fun stats — hidden until ≥1 playback. -->
                <LinearLayout
                    android:id="@+id/settings_stats_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout style="@style/SettingsStatBlock">
                        <TextView android:id="@+id/stat_movies_value" style="@style/SettingsStatValue" tools:text="34" />
                        <TextView style="@style/SettingsStatLabel" android:text="@string/settings_stat_movies" />
                    </LinearLayout>
                    <View android:layout_width="24dp" android:layout_height="1dp" />
                    <LinearLayout style="@style/SettingsStatBlock">
                        <TextView android:id="@+id/stat_hours_value" style="@style/SettingsStatValue" tools:text="78" />
                        <TextView style="@style/SettingsStatLabel" android:text="@string/settings_stat_hours" />
                    </LinearLayout>
                    <View android:layout_width="24dp" android:layout_height="1dp" />
                    <LinearLayout style="@style/SettingsStatBlock">
                        <TextView android:id="@+id/stat_days_value" style="@style/SettingsStatValue" tools:text="3" />
                        <TextView style="@style/SettingsStatLabel" android:text="@string/settings_stat_days" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============= MY ACTIVITY ============= -->
        <TextView style="@style/SettingsSectionHeader"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_activity" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <LinearLayout
                android:id="@+id/tile_watch_history"
                style="@style/SettingsTile"
                android:layout_marginEnd="8dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_history" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_history_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_history_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_liked"
                style="@style/SettingsTile"
                android:layout_marginStart="8dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_heart" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_liked_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_liked_sub" />
                </LinearLayout>
            </LinearLayout>
        </GridLayout>

        <!-- ============= CATALOGUE ============= -->
        <TextView style="@style/SettingsSectionHeader"
            android:layout_marginTop="26dp"
            android:text="@string/settings_section_catalogue" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <!-- Scan latest movies (status pill + meta) -->
            <LinearLayout
                android:id="@+id/tile_scan"
                style="@style/SettingsTile"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_refresh" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_scan_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_scan_sub" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/scan_status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_unknown"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <View
                            android:id="@+id/scan_status_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_unknown" />
                        <TextView
                            android:id="@+id/scan_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/settings_scan_status_unknown"
                            android:textColor="@color/text_primary"
                            android:textSize="9sp"
                            android:letterSpacing="0.16"
                            android:textAllCaps="true"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/scan_relative_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2h ago" />

                    <TextView
                        android:id="@+id/scan_date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        tools:text="08-06-2026 05:18" />
                </LinearLayout>
            </LinearLayout>

            <!-- Show HD only — ON/OFF pill, no SwitchCompat (crashed + UX issues) -->
            <LinearLayout
                android:id="@+id/tile_hd_only"
                style="@style/SettingsTile"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_hd" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_hd_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_hd_sub" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tile_hd_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_settings_onoff_pill"
                    android:text="@string/settings_off"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />
            </LinearLayout>

            <!-- Video engine (Auto / Exo / VLC) — spans both columns since the helper text is long. -->
            <LinearLayout
                android:id="@+id/tile_video_engine"
                style="@style/SettingsTile"
                android:layout_columnSpan="2"
                android:layout_gravity="fill_horizontal">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_engine" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_engine_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_engine_sub" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tile_engine_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:minWidth="64dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_settings_onoff_pill"
                    android:text="@string/settings_engine_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>
        </GridLayout>

        <!-- ============= DEVICE & APP ============= -->
        <TextView style="@style/SettingsSectionHeader"
            android:layout_marginTop="26dp"
            android:text="@string/settings_section_device" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <LinearLayout
                android:id="@+id/tile_cache"
                style="@style/SettingsTile"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_cache" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_cache_title" />
                    <TextView
                        android:id="@+id/tile_cache_sub"
                        style="@style/SettingsTileSubtitle"
                        android:text="@string/settings_tile_cache_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_about"
                style="@style/SettingsTile"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_info" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_about_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_about_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_terms"
                style="@style/SettingsTile"
                android:layout_marginEnd="8dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_terms" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle" android:text="@string/settings_tile_terms_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_terms_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_reset"
                style="@style/SettingsTile.Danger"
                android:layout_marginStart="8dp">
                <ImageView style="@style/SettingsTileIcon" android:src="@drawable/ic_settings_reset" />
                <LinearLayout style="@style/SettingsTileText">
                    <TextView style="@style/SettingsTileTitle.Danger" android:text="@string/settings_tile_reset_title" />
                    <TextView style="@style/SettingsTileSubtitle" android:text="@string/settings_tile_reset_sub" />
                </LinearLayout>
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</ScrollView>
