<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen shimmer placeholder.

  Mirrors the production layout 1:1 so the cross-fade into the real UI
  has zero visible reflow:
    - Top 60%  : preview block — dark text panel (left 30%) with a title
                 bar + chips row placeholders, plus a wide shimmering
                 backdrop area (right 70%).
    - Strip    : section title placeholder overlapping the bottom of the
                 preview (matches activity_main.xml's section_title_label).
    - Bottom 40%: rails on a pure-black background. ShimmerOverlay resizes
                 each `shimmer_card`-tagged tile to the same adaptive
                 footprint MovieCardPresenter uses, so the silhouette
                 matches exactly.
-->
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_shimmer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:focusable="false"
    android:clickable="false"
    android:descendantFocusability="blocksDescendants"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.85"
    app:shimmer_highlight_alpha="1.0"
    app:shimmer_duration="1200">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Mirror activity_main.xml: 60/40 horizontal split. -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/shimmer_preview_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.60" />

        <!-- Vertical guideline at 30% — text panel / backdrop split. -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/shimmer_text_panel_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.30" />

        <!-- Backdrop placeholder (right 70% of preview area). -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shimmer_card_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shimmer_preview_bottom"
            app:layout_constraintStart_toStartOf="@id/shimmer_text_panel_end"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Text panel placeholders (left 30%): title bar, rating chip,
             duration line + badge strip. Centered vertically to match
             view_home_preview.xml. -->
        <LinearLayout
            android:id="@+id/shimmer_text_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shimmer_preview_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/shimmer_text_panel_end">

            <View
                android:layout_width="220dp"
                android:layout_height="34dp"
                android:background="@drawable/shimmer_card_bg" />

            <View
                android:layout_width="160dp"
                android:layout_height="18dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shimmer_card_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <View
                    android:layout_width="44dp"
                    android:layout_height="20dp"
                    android:background="@drawable/shimmer_card_bg" />
                <View
                    android:layout_width="36dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shimmer_card_bg" />
                <View
                    android:layout_width="52dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shimmer_card_bg" />
            </LinearLayout>

        </LinearLayout>

        <!-- Section title placeholder, sits at the bottom of the preview
             area just like activity_main.xml > section_title_label. -->
        <View
            android:layout_width="220dp"
            android:layout_height="22dp"
            android:layout_marginStart="80dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/shimmer_card_bg"
            app:layout_constraintBottom_toTopOf="@id/shimmer_preview_bottom"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Rails area: pure black bg, one full rail + peek of next. -->
        <LinearLayout
            android:id="@+id/shimmer_rails"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/black"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="0dp"
            app:layout_constraintTop_toTopOf="@id/shimmer_preview_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include layout="@layout/view_shimmer_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="7dp" />

            <include layout="@layout/view_shimmer_row" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
