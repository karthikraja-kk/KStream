<?xml version="1.0" encoding="utf-8"?>
<!--
  Movie card (flat tile redesign).

  Single resting state — 120×180 portrait poster with a title below.
  Focus is indicated by the focus_ring_glow drawable applied as the
  poster_container's foreground; no morph, no scale, no overlay.

  All focus-state propagation flows from the focusable card_root down
  through every wrapper via duplicateParentState="true" so the gold
  halo / brand-gradient stroke lights up correctly when the inner tile
  receives focus.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="@dimen/card_root_width"
    android:layout_height="wrap_content"
    android:padding="@dimen/card_focus_padding"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/card_poster_container"
            android:layout_width="@dimen/card_poster_width"
            android:layout_height="@dimen/card_poster_height"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/card_poster_portrait"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_poster_bg"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@color/bg_surface" />

            <TextView
                android:id="@+id/card_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/badge_quality_bg"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="2dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="HD"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/card_new_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/badge_new_bg"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="2dp"
                android:text="@string/badge_new"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:id="@+id/card_progress"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:background="@color/accent_primary"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/card_title"
            android:layout_width="@dimen/card_poster_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.KStream.Card"
            tools:text="A Very Long Movie Title" />

    </LinearLayout>

</FrameLayout>
