<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:descendantFocusability="afterDescendants">

    <ImageView
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/backdrop_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_vertical" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="120dp"
            android:paddingBottom="56dp">

            <ImageView
                android:id="@+id/details_logo"
                android:layout_width="320dp"
                android:layout_height="120dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/details_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                tools:text="Movie Title" />

            <TextView
                android:id="@+id/details_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="A heart-stopping thriller." />

            <TextView
                android:id="@+id/details_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_tertiary"
                android:textSize="16sp"
                tools:text="2024  •  2h 14m  •  ★ 8.2  •  EN" />

            <LinearLayout
                android:id="@+id/genre_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/details_synopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxWidth="780dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:maxLines="5"
                android:ellipsize="end"
                tools:text="Synopsis goes here..." />

            <TextView
                android:id="@+id/synopsis_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/focus_ring_low"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="▾ More" />

            <TextView
                android:id="@+id/details_director"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Directed by Christopher Nolan" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_play"
                    style="@style/TvActionButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details_play" />

                <!-- Unified Resume pill: label + ▾ chevron + thin progress
                     hairline at bottom. Single focusable target; clicking the
                     body resumes, pressing DPAD_DOWN opens the More menu.
                     Visible only when hasWatchProgress=true; Play is hidden. -->
                <FrameLayout
                    android:id="@+id/resume_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_resume_pill"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:minWidth="180dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/resume_label_row"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="22dp">

                        <TextView
                            android:id="@+id/resume_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_resume"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/resume_chevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="▾"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Very thin progress hairline anchored to bottom edge,
                         clipped by the pill's rounded outline. -->
                    <View
                        android:id="@+id/resume_progress_fill"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_gravity="bottom|start"
                        android:background="@color/text_primary" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_like"
                    style="@style/TvActionButton.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/details_like" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/details_quality"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/quality_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/cast_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/details_cast"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/cast_grid"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/similar_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/details_similar"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/similar_grid"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="0dp"
                android:paddingEnd="280dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_primary"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="Failed to load" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/TvActionButton.Primary"
            android:layout_marginTop="20dp"
            android:text="@string/details_retry" />
    </LinearLayout>

</FrameLayout>
