<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:descendantFocusability="afterDescendants">

    <ImageView
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/backdrop_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_vertical" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="120dp"
            android:paddingBottom="56dp">

            <ImageView
                android:id="@+id/details_logo"
                android:layout_width="320dp"
                android:layout_height="120dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/details_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                tools:text="Movie Title" />

            <TextView
                android:id="@+id/details_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="A heart-stopping thriller." />

            <TextView
                android:id="@+id/details_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_tertiary"
                android:textSize="16sp"
                tools:text="2024 | 2h 14m | Drama" />

            <TextView
                android:id="@+id/details_synopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxWidth="780dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:maxLines="5"
                android:ellipsize="end"
                tools:text="Synopsis goes here..." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_play"
                    style="@style/TvActionButton.Primary"
                    android:text="@string/details_play" />

                <Button
                    android:id="@+id/btn_resume"
                    style="@style/TvActionButton.Secondary"
                    android:layout_marginStart="12dp"
                    android:text="@string/details_resume"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_download"
                    style="@style/TvActionButton.Secondary"
                    android:layout_marginStart="12dp"
                    android:text="@string/details_download" />

                <Button
                    android:id="@+id/btn_like"
                    style="@style/TvActionButton.Secondary"
                    android:layout_marginStart="12dp"
                    android:text="@string/details_like" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/details_quality"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/quality_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/cast_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/details_cast"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/cast_grid"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_primary"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="Failed to load" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/TvActionButton.Primary"
            android:layout_marginTop="20dp"
            android:text="@string/details_retry" />
    </LinearLayout>

</FrameLayout>
