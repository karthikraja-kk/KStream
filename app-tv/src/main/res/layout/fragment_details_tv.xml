<?xml version="1.0" encoding="utf-8"?>
<!--
  Redesigned Details screen. Single frosted-glass card on a cinematic
  backdrop carrying every "this movie" piece of info; landscape hero
  pinned top-right. Below the fold (scrollable): More Like This.
  Existing view IDs are preserved so DetailsTvFragment.kt keeps binding
  the same handles; new IDs added: badge_new, hero_landscape,
  meta_chips_row, resume_split, resume_caret, resume_progress_track,
  resume_progress_fill, resume_progress_label, resume_group.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:descendantFocusability="afterDescendants">

    <ImageView
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/backdrop_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_vertical" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="64dp"
            android:paddingBottom="56dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_details_glass_card"
                android:padding="32dp">

                <LinearLayout
                    android:id="@+id/hero_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/badge_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/preview_badge_new_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/badge_new"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/hero_landscape"
                        android:layout_width="280dp"
                        android:layout_height="158dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_hero_landscape"
                        android:clipToOutline="true"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/content_padded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="300dp">

                    <ImageView
                        android:id="@+id/details_logo"
                        android:layout_width="320dp"
                        android:layout_height="100dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/details_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.02"
                        tools:text="Inception" />

                    <TextView
                        android:id="@+id/details_tagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="17sp"
                        android:textStyle="italic"
                        android:visibility="gone"
                        tools:text="Your mind is the scene of the crime."
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/meta_chips_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/genre_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/details_synopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:maxWidth="820dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:lineSpacingMultiplier="1.55"
                        android:maxLines="5"
                        android:ellipsize="end"
                        tools:text="Synopsis goes here..." />

                    <TextView
                        android:id="@+id/synopsis_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/focus_ring_low"
                        android:focusable="true"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/accent_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="▾ More" />

                    <TextView
                        android:id="@+id/details_director"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Directed by Christopher Nolan"
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/details_quality"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <LinearLayout
                        android:id="@+id/quality_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <Button
                            android:id="@+id/btn_play"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:minWidth="120dp"
                            android:background="@drawable/bg_brand_gradient_btn"
                            android:paddingHorizontal="24dp"
                            android:text="@string/details_play"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:elevation="6dp" />

                        <LinearLayout
                            android:id="@+id/resume_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/resume_split"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:orientation="horizontal"
                                android:elevation="6dp">

                                <FrameLayout
                                    android:id="@+id/resume_pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_resume_split_left"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:minWidth="180dp"
                                    android:nextFocusRight="@+id/resume_caret">

                                    <TextView
                                        android:id="@+id/resume_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:paddingHorizontal="20dp"
                                        android:text="@string/details_resume"
                                        android:textColor="#FFFFFF"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </FrameLayout>

                                <FrameLayout
                                    android:id="@+id/resume_caret"
                                    android:layout_width="46dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_resume_split_right"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="@string/details_start_over"
                                    android:nextFocusLeft="@id/resume_pill">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="↺"
                                        android:textColor="#FFFFFF"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />
                                </FrameLayout>
                            </LinearLayout>

                            <FrameLayout
                                android:id="@+id/resume_progress_track"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_resume_progress_track">

                                <View
                                    android:id="@+id/resume_progress_fill"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_resume_progress_fill" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/resume_progress_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                tools:text="42:18 / 2:28:00 · 28 % watched" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_like"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:minWidth="46dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_ghost_btn"
                            android:paddingHorizontal="18dp"
                            android:text="@string/details_like"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/cast_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="@string/details_cast"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"
                        android:visibility="gone" />

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/cast_grid"
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/similar_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/details_similar"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/similar_grid"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="0dp"
                android:paddingEnd="280dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_primary"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="Failed to load" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/TvActionButton.Primary"
            android:layout_marginTop="20dp"
            android:text="@string/details_retry" />
    </LinearLayout>

    <TextView
        android:id="@+id/details_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>
