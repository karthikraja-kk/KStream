<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/poster_frame"
        android:layout_width="132dp"
        android:layout_height="192dp"
        android:layout_gravity="center_horizontal"
        android:foreground="@drawable/bg_personal_poster_ring"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/poster_image"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/card_poster_bg"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/check_overlay"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_personal_check"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/movie_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/movie_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_personal_badge"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
