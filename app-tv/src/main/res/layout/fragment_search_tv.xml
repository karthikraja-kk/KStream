<?xml version="1.0" encoding="utf-8"?>
<!--
  Search screen — premium OTT (compact toolbar redesign).

  Header: a single 52dp toolbar combining
     [scope icon] [sort icon] [voice icon] [============= input pill ==============]
  Tapping the scope/sort icons opens an AlertDialog with single-choice
  options. This collapses the previous two chip rows into the same line
  as the input, freeing 100dp+ of vertical space for the results grid.

  Below: a single content area that shows EITHER:
   - search_recents_container  (idle: no query)
   - search_typeahead_container (typing: suggestions panel)
   - search_results_container   (results header + grid)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:descendantFocusability="afterDescendants"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Toolbar: voice + input pill + scope + sort. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/search_voice"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_voice"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:contentDescription="@string/search_voice_content_desc"
            android:focusable="true"
            android:layout_marginEnd="12dp"
            android:nextFocusRight="@+id/search_input" />

        <FrameLayout
            android:id="@+id/search_input_pill"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:addStatesFromChildren="true"
            android:focusable="false"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_search"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="36dp"
                android:paddingEnd="48dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint_movie"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="18sp"
                android:textCursorDrawable="@null"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:nextFocusLeft="@id/search_voice"
                android:nextFocusRight="@+id/search_scope_icon" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_search_clear"
                android:src="@drawable/ic_clear_pill"
                android:scaleType="centerInside"
                android:contentDescription="@string/search_clear_content_desc"
                android:focusable="true"
                android:nextFocusLeft="@id/search_input"
                android:nextFocusRight="@+id/search_scope_icon"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/search_scope_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_voice"
            android:src="@drawable/ic_search_filter"
            android:scaleType="centerInside"
            android:contentDescription="@string/search_scope_label"
            android:focusable="true"
            android:layout_marginEnd="10dp"
            android:nextFocusLeft="@id/search_input"
            android:nextFocusRight="@+id/search_sort_icon" />

        <ImageButton
            android:id="@+id/search_sort_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_voice"
            android:src="@drawable/ic_search_sort"
            android:scaleType="centerInside"
            android:contentDescription="@string/search_sort_label"
            android:focusable="true"
            android:nextFocusLeft="@id/search_scope_icon" />

    </LinearLayout>

    <!-- Did-you-mean banner -->
    <TextView
        android:id="@+id/search_suggest_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_search_suggest_banner"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ===== Content area (one of three visible at a time) ===== -->

    <!-- Recents (idle) -->
    <LinearLayout
        android:id="@+id/search_recents_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/search_recent_label"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/search_recents_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_recent_clear"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:padding="6dp"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/search_recents_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Typeahead (typing) -->
    <LinearLayout
        android:id="@+id/search_typeahead_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="6dp"
        android:background="@drawable/bg_search_typeahead"
        android:visibility="gone">

        <TextView
            android:id="@+id/search_typeahead_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/search_typeahead_label"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/search_typeahead_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/search_typeahead_show_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:focusable="true"
            android:background="@drawable/bg_search_suggestion"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Results -->
    <LinearLayout
        android:id="@+id/search_results_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/search_results_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/search_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_loading"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/search_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:focusable="true" />
    </LinearLayout>

    <!-- Voice listening overlay -->
    <FrameLayout
        android:id="@+id/search_voice_overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0"
        android:visibility="gone" />

</LinearLayout>

<!-- ===== Scope panel (search-by) - right anchored, 240dp wide ===== -->
<LinearLayout
    android:id="@+id/search_scope_panel"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="86dp"
    android:layout_marginEnd="24dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_search_dropdown_panel"
    android:elevation="12dp"
    android:visibility="gone" />

<!-- ===== Sort panel (sort-by) - right anchored, 240dp wide ===== -->
<LinearLayout
    android:id="@+id/search_sort_panel"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="86dp"
    android:layout_marginEnd="24dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_search_dropdown_panel"
    android:elevation="12dp"
    android:visibility="gone" />


    <!--
      Voice search overlay: full-screen scrim + brand mic + live transcript.
      Hidden by default; shown by SearchTvFragment.showVoiceOverlay() when
      the user taps the mic. Replaces the old system app-chooser dialog.
    -->
    <FrameLayout
        android:id="@+id/voice_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_voice_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp">

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/voice_mic_ring"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_mic_ring" />

                <View
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_mic_disc" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="@string/search_voice_listening"
                    android:tint="@android:color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/voice_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/search_voice_listening"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voice_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FFCCCCCC"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/search_voice_hint"
                android:textColor="#FF888888"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout></FrameLayout>
