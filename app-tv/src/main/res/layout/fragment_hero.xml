<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero carousel layout: full-bleed backdrop, gradient scrim on bottom 60%,
  content stack (title / meta / synopsis / buttons / dots) anchored bottom-left
  inside overscan-safe insets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/hero_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Gradient scrim covers the bottom 60% only; backdrop top stays clean. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/tv_overscan_horizontal"
        android:layout_marginEnd="@dimen/tv_overscan_horizontal"
        android:layout_marginBottom="@dimen/space_xl"
        android:maxWidth="900dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.KStream.Display" />

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.KStream.Meta" />

        <TextView
            android:id="@+id/hero_synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.KStream.Body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hero_btn_play"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/focus_ring_glow"
                android:minWidth="180dp"
                android:paddingHorizontal="@dimen/space_lg"
                android:text="@string/hero_btn_play"
                android:textAllCaps="true"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/hero_btn_more"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/focus_ring_low"
                android:minWidth="180dp"
                android:paddingHorizontal="@dimen/space_lg"
                android:text="@string/hero_btn_more"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/hero_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal" />

    </LinearLayout>

</FrameLayout>
