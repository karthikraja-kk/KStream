<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_personal_gradient"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp" android:paddingTop="20dp" android:paddingEnd="48dp" android:paddingBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Liked movies"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/select_button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_personal_select_pill"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="Select"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/select_toolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/selected_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/select_all_button"
                style="@style/PersonalToolbarAction"
                android:text="Select all" />
            <TextView
                android:id="@+id/clear_button"
                style="@style/PersonalToolbarAction"
                android:text="Clear" />
            <TextView
                android:id="@+id/delete_button"
                style="@style/PersonalToolbarAction"
                android:text="Unlike" />
            <TextView
                android:id="@+id/cancel_button"
                style="@style/PersonalToolbarAction"
                android:text="Cancel" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/movie_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No liked movies yet"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Movies you like will appear here."
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="56dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
