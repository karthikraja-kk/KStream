<?xml version="1.0" encoding="utf-8"?>
<!--
  Sticky preview pane shown above the rails on the home screen.
  Mirrors whichever rail tile currently has focus.

  Layout:
    Left 30% (text_panel_end vertical guideline at 0.30):
      Solid black text panel: brand-gradient title, ★ rating + year row,
      and duration line.
    Right 70%:
      Backdrop area. Two stacked ImageViews:
        - preview_backdrop_blur : same image scaled+blurred, fills the
                                  entire 70% area, shown only when the
                                  primary image isn't a 16:9 landscape
                                  (portrait fallback / odd aspect).
        - preview_backdrop      : sharp image. scaleType is flipped at
                                  runtime — centerCrop for true landscape
                                  backdrops, fitCenter for portrait/odd
                                  so the whole image is visible centered.
    Fades stacked on top of backdrop area:
      - preview_fade_left   : 120dp horizontal fade from black → transparent
                              starting at the 30% guideline, hides the seam
                              between text panel and backdrop.
      - preview_fade_bottom : 80dp vertical fade from transparent → black
                              at the bottom of the backdrop area, hides the
                              seam between preview and rails.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- Vertical guideline splitting the preview into 30% text panel /
         70% backdrop area. All right-side elements constrain their start
         edge to this guideline. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/text_panel_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <!-- Backdrop area background. Always black so portrait letterbox bars
         (when blur fill isn't enough) read as solid panel. -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/preview_backdrop_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/preview_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Crossfade overlay used by BackdropCarousel — sits on top of
      preview_backdrop. While idle, alpha = 0 (invisible). To advance the
      carousel we load the next image into THIS view, fade alpha 0→1, then
      copy the drawable into preview_backdrop and reset alpha = 0 ready for
      the next tick. preview_backdrop is therefore always the "stable" view
      that holds the currently-displayed image.
    -->
    <ImageView
        android:id="@+id/preview_backdrop_next"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left fade so the backdrop blends into the black text panel. -->
    <View
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:background="@drawable/preview_fade_left_to_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end" />

    <!-- Bottom fade so the backdrop blends into the rails area below. -->
    <View
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/preview_fade_top_to_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_panel_end"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Text panel, vertically centred in the left 30% (with side-nav clear). -->
    <LinearLayout
        android:id="@+id/preview_text_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/text_panel_end">

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Mission: Impossible — Dead Reckoning" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preview_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="★ 7.8" />

            <TextView
                android:id="@+id/preview_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="2024" />

        </LinearLayout>

        <!-- Metadata badge strip: NEW, HD, certification (e.g. PG-13).
             Each badge hides itself when its underlying datum is absent. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preview_badge_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/preview_badge_new_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="NEW"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/preview_badge_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/preview_badge_quality_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone"
                tools:text="HD"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/preview_badge_cert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/preview_badge_cert_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:visibility="gone"
                tools:text="PG-13"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/preview_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="02:13:12" />

    </LinearLayout>

    <!--
      End-of-fact-bubble guideline. The bubble extends past the 30% text
      panel into the backdrop area as a translucent overlay so it has
      room to breathe and longer fact sentences don't wrap into 4+ lines.
    -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/fact_bubble_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <!--
      Fact "chat bubble" — anchored to the TOP of the preview, sitting as
      an overlay on the backdrop. The text panel below stays
      vertically-centered so there's natural breathing room between bubble
      and title block.

      Container constrains the bubble's allowed area; the body itself is
      wrap_content with a maxWidth so short messages hug their content
      while long messages wrap onto 2-3 lines.

      Hidden by default. Shown only when FactBubble.build() returns non-null.
    -->
    <LinearLayout
        android:id="@+id/preview_fact_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fact_bubble_end"
        tools:visibility="visible">

        <TextView
            android:id="@+id/preview_fact_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_fact_avatar"
            android:gravity="center"
            android:text="K"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:id="@+id/preview_fact_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_fact_bubble"
            android:maxWidth="420dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/preview_fact_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Hey Aravind," />

            <TextView
                android:id="@+id/preview_fact_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="did you know Inception's tagline is &quot;Your mind is the scene of the crime&quot;?" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
