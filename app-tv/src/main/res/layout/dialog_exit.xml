<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_exit_dialog"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/exit_logo"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:adjustViewBounds="true"
        android:src="@drawable/kstream_logo_horizontal"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/exit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/exit_dialog_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/exit_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exit_dialog_message"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/exit_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/exit_dialog_negative"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:background="@drawable/bg_exit_button"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/exit_btn_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/exit_dialog_positive"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:background="@drawable/bg_exit_button"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>
</LinearLayout>
